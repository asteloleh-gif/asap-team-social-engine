  "derived_metrics": [
    {
      "name": "engagement_rate_reach",
      "unit": "percent",
      "formula": "100 * sum(frozen nonoverlapping available engagement components) / reach",
      "requires": [
        "reach > 0",
        "same post and snapshot",
        "component_set_id fixed before comparison"
      ],
      "missing_policy": "unavailable; partial component sets must use a distinct metric name"
    },
    {
      "name": "engagement_rate_views",
      "unit": "percent",
      "formula": "100 * sum(frozen nonoverlapping available engagement components) / views",
      "requires": [
        "views > 0",
        "same definition and component_set_id"
      ],
      "missing_policy": "unavailable; never silently substitute for ER_reach"
    },
    {
      "name": "meaningful_comment_rate",
      "unit": "per_1000_denominator",
      "formula": "1000 * distinct substantive external commenters / frozen_denominator",
      "requires": [
        "manual/editorial comment coding with evidence",
        "exclude owner/brand, spam, duplicates and emoji-only",
        "denominator > 0"
      ],
      "missing_policy": "unavailable; do not treat raw replies as coded meaningful replies"
    },
    {
      "name": "share_repost_rate",
      "unit": "per_1000_denominator",
      "formula": "1000 * nonoverlapping native sharing components / frozen_denominator",
      "requires": [
        "provider component overlap audited",
        "denominator > 0"
      ],
      "missing_policy": "unavailable"
    },
    {
      "name": "save_rate",
      "unit": "per_1000_denominator",
      "formula": "1000 * saves / frozen_denominator",
      "requires": [
        "post saves available",
        "denominator > 0"
      ],
      "missing_policy": "unavailable"
    },
    {
      "name": "profile_visit_rate",
      "unit": "per_1000_denominator",
      "formula": "1000 * post_attributed_profile_visits / frozen_denominator",
      "requires": [
        "post attribution verified",
        "denominator > 0"
      ],
      "missing_policy": "unavailable; account visits are diagnostic only"
    },
    {
      "name": "follow_rate",
      "unit": "per_1000_denominator",
      "formula": "1000 * post_attributed_follows / frozen_denominator",
      "requires": [
        "post attribution verified",
        "denominator > 0"
      ],
      "missing_policy": "unavailable; account net follows are not post follows"
    },
    {
      "name": "attributed_follow_conversion",
      "unit": "percent",
      "formula": "100 * post_attributed_follows / post_attributed_profile_visits",
      "requires": [
        "same post and window for both fields",
        "profile_visits > 0"
      ],
      "missing_policy": "unavailable; no causal post attribution from account-level change"
    }
  ],
  "denominator_defaults": {
    "threads": "post views, only if actual endpoint provides this metric",
    "instagram": "post reach; separate named views-based rates if reach unavailable",
    "facebook": "post reach; separate named views-based rates if reach unavailable"
  },
  "snapshot_policy": {
    "hours": [
      24,
      72
    ],
    "save_actual_age": true,
    "cumulative_not_incremental": true,
    "late_snapshot": "Keep the observed value with availability available when successfully read, flag window_status late and actual age; not eligible for exact-age comparison without a predeclared tolerance rule."
  },
  "account_diagnostics": [
    "followers_start",
    "followers_end",
    "followers_gained",
    "followers_lost",
    "net_follower_change",
    "account_profile_visits"
  ],
  "account_diagnostics_rule": "Keep periods and attribution separate from post metrics. Do not infer gained from net or sum follower counts across platforms as unique people.",
  "cost_fields": {
    "ai_api_cost": null,
    "worker_cost": null,
    "storage_cost": null,
    "currency": null,
    "availability": "unknown",
    "note": "This drafting run made no paid AI/media calls; existing runtime costs were not measured."
  },
  "guardrails": [
    "no manufactured engagement or paid boost in organic cohort",
    "no deletion of weak posts",
    "no after-the-fact primary metric substitution",
    "no cross-platform rate rankings with unlike denominators",
    "no combining mirrored connector values"
  ],
